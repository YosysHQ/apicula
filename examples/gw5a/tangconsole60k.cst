IO_PORT "led[14]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[15]" E21;
IO_PORT "led[15]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "rst_i" AB13;
IO_PORT "rst_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// femto
IO_LOC  "clk_i" V22;
IO_PORT "clk_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// usb uart
IO_LOC  "RXD" V14;
IO_PORT "RXD" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "TXD" U15;
IO_PORT "TXD" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// The 40-pin RGB LCD connector (schematic 32001C, LCD_DPI). The examples
// drive 4 bits a colour, on each colour's top four (R4-R7, G4-G7, B4-B7);
// the backlight's enable (P20) is pulled up on the board.
// N20, M20, N22, M22 and U22 are also configuration pins: build with sspi_as_gpio.
IO_LOC  "LCD_CLK" L19;
IO_PORT "LCD_CLK" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_HYNC" N20;
IO_PORT "LCD_HYNC" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_SYNC" L15;
IO_PORT "LCD_SYNC" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_DEN" U22;
IO_PORT "LCD_DEN" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_R[0]" H22;
IO_PORT "LCD_R[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_R[1]" J22;
IO_PORT "LCD_R[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_R[2]" K22;
IO_PORT "LCD_R[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_R[3]" K21;
IO_PORT "LCD_R[3]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_G[0]" M21;
IO_PORT "LCD_G[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_G[1]" M22;
IO_PORT "LCD_G[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_G[2]" N22;
IO_PORT "LCD_G[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_G[3]" K19;
IO_PORT "LCD_G[3]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_B[0]" N18;
IO_PORT "LCD_B[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_B[1]" K16;
IO_PORT "LCD_B[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_B[2]" L16;
IO_PORT "LCD_B[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "LCD_B[3]" M20;
IO_PORT "LCD_B[3]" PULL_MODE=NONE IO_TYPE=LVCMOS33;

// pll7's outputs, on PMOD1 (the led[8]-led[15] pins).
IO_LOC  "lock" W20;
IO_PORT "lock" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "clkout0" F20;
IO_PORT "clkout0" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "clkout1" D22;
IO_PORT "clkout1" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "clkout2" D21;
IO_PORT "clkout2" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "clkout3" W19;
IO_PORT "clkout3" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "clkout4" F19;
IO_PORT "clkout4" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "clkout5" E22;
IO_PORT "clkout5" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC  "clkout6" E21;
IO_PORT "clkout6" PULL_MODE=NONE IO_TYPE=LVCMOS33;

CLOCK_LOC "spec_tick_hz" BUFG;
